# Leave database variables unset to use SQLite.
# Uncomment these only when you want PostgreSQL.
# DB_NAME=payment_gateway_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# Or, on Render, set this and the app will use it instead of SQLite.
# DATABASE_URL=postgres://user:password@host:5432/dbname

SECRET_KEY=change-me
DEBUG=True

# Comma-separated hosts, if you need more than localhost.
ALLOWED_HOSTS=

FRONTEND_URI=http://localhost:5173

# Leave PAYMENT_MODE as auto.
# Empty keys: practice checkout on this server.
# rzp_test_... keys: real Razorpay checkout, test card, no real charge.
# rzp_live_... keys: real Razorpay checkout, real card charge.
PAYMENT_MODE=auto
DEMO_SIGNING_SECRET=change-me-for-shared-demos

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only if the Razorpay dashboard webhook secret is different from the key secret.
# RAZORPAY_WEBHOOK_SECRET=

# Optional admin created by build.sh / create_admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
